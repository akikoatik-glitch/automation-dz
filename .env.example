# ===== DATABASE =====
# PostgreSQL is required (local dev + production).
# Local: install Postgres OR use a free Neon/Supabase database and point it here.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ===== AUTH SECRET =====
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-please"
ADMIN_EMAIL="admin@wassil.dz"

# ===== NEXT AUTH =====
# In production set this to your public domain (no trailing slash), e.g.
# NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string-please"

# ===== CRON (protect scheduled jobs endpoint + Vercel Cron) =====
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` — set CRON_KEY equal to it.
CRON_KEY="change-me-cron-key"

# ===== AI (optional, OpenAI-compatible) =====
# Leave empty to use the built-in rule-based assistant (works offline).
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# ===== EMAIL / SMTP (optional) =====
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Wassil <no-reply@wassil.dz>"

# ===== PLATFORM =====
APP_NAME="Wassil"
# Public base URL — used for any absolute links. Production example:
# APP_URL="https://your-app.vercel.app"
APP_URL="http://localhost:3000"
DEFAULT_LANG="fr"
